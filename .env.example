# Copy to .env and replace the <placeholders>. Never commit .env.
ENVIRONMENT=development
APP_TIMEZONE=Asia/Kolkata

# Local: mongodb://localhost:27017   Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=<your-mongodb-uri>
MONGODB_DB_NAME=<your-database-name>

GEMINI_API_KEY=<your-gemini-api-key>
# Any Gemini model, e.g. gemini-3.5-flash-lite
AI_MODEL=<your-gemini-model>
AI_CHAT_TIMEOUT_SECONDS=15
AI_SUMMARY_TIMEOUT_SECONDS=20

# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173
# Per client IP, sliding window
RATE_LIMIT_DEFAULT=10/minute
RATE_LIMIT_AI=3/minute;20/day
